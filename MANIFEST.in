include .pre-commit-config.yaml
include .gitattributes
include DEV_PREVIEW.md
include dev.sh
include plugin.toml
include versions.yaml
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github/workflows *.yml
recursive-include compat *.patch *.toml
include docs/SPARKROUTE_BRIDGE.md
include docs/RELEASING.md
include REUSE.toml
include .gitleaksignore
recursive-include LICENSES *.txt
prune .dev
prune .slop
prune .venv
prune build
prune dist
global-exclude __pycache__ *.py[cod]
